 "session": "2025R1",
 "measure": "SB 430",
 "measure_id": "SB430",
 "subject": "or_legislature/2025R1/SB430",
 "title": "Prohibits a person that offers or sells goods or services online from advertising, displaying or offering a price for the goods or services that does not include all fees or charges that a purchaser must pay to complete a transaction for the goods or services, other than taxes or fees that a governmental body imposes on the transaction, reasonable charges that the person actually incurs to ship the goods or provide the services or a service fee that is calculated according to distance or a purchaser's selections.",
 "outcome": "law",
