 "measure": "HB 2008",
 "measure_id": "HB2008",
 "subject": "or_legislature/2025R1/HB2008",
 "title": "Prohibits controllers from processing personal data for the purposes of targeted advertising, or selling personal data that pertains to a consumer, if the controller has actual knowledge, or disregards knowledge of whether, a consumer is under 16 years of age or if the personal data accurately identifies within a radius of 1,750 feet a consumer's present or past location or the present or past location of a device that links or is linkable to the consumer.",
 "outcome": "law",
